# X Analyst Outreach Automation - environment template (Workflow A only).
# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# ---------------------------------------------------------------------------
# LLM provider: OpenAI-compatible. Switch providers by changing LLM_BASE_URL
# ONLY (no code edits). Two models, pinned. Never auto-upgrade.
#
# TESTING options:
#   DeepSeek direct:  LLM_BASE_URL=https://api.deepseek.com
#                     DEFAULT_MODEL=deepseek-v4-flash  PREMIUM_MODEL=deepseek-v4-pro
#   Groq:             LLM_BASE_URL=https://api.groq.com/openai/v1
#                     DEFAULT_MODEL=llama-3.1-8b-instant
#                     PREMIUM_MODEL=llama-3.3-70b-versatile
#
# PRODUCTION (later): Azure AI Foundry, billed to Azure startup credits
#   LLM_BASE_URL=https://<project>.services.ai.azure.com/models
#   DEFAULT_MODEL=DeepSeek-V4-Flash  PREMIUM_MODEL=DeepSeek-V4-Pro
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
DEFAULT_MODEL=llama-3.1-8b-instant
PREMIUM_MODEL=llama-3.3-70b-versatile

# Tavily (open-web search). Free tier ~1000 searches/month.
TAVILY_API_KEY=

# Apollo (email enrichment). REQUIRED: Workflow A contacts arrive with no email.
# If missing, the enrichment step prints a manual-CSV fallback and exits cleanly.
APOLLO_API_KEY=

# Postgres. Queue + state store + log. No Redis/Qdrant/vector DB.
# NOTE: if the password contains URL-reserved characters (@ : / ? #), percent-encode
# them, e.g. '@' -> '%40'. Otherwise the URI parser misreads the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach

# Telegram bot (polling mode). Numeric user id restricts who can command it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Gmail. TEST MODE: owner's own Gmail. PRODUCTION: re-run OAuth with
# Harpreet's account and replace the cached token. Scope is gmail.compose ONLY.
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Competitor discovery cap (safety valve).
MAX_COMPETITORS=100

# Per-firm research concurrency. Azure AI Foundry's 20K TPM limit REQUIRES 1
# (sequential) or the run 429s and drops firms. Raise only on a higher-TPM tier.
RESEARCH_WORKERS=1
